# Local API server
PORT=3001

# Gemini API keys, comma-separated for rotation (required for chat)
GEMINI_API_KEYS=

# Optional model override, comma-separated
GEMINI_MODELS=gemini-flash-lite-latest,gemini-3-flash-preview,gemma-4-26b-a4b-it

# Google OAuth credentials
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3002/api/auth/google/callback
APP_ORIGIN=http://127.0.0.1:3002

# MongoDB
MONGODB_URI=
DB_NAME=fastlearn
