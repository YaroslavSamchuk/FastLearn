# Local API server
PORT=3001

# Gemini API keys, comma-separated for rotation (required for chat)
GEMINI_API_KEYS=

# Optional model override, comma-separated
GEMINI_MODELS=gemini-flash-lite-latest,gemini-3-flash-preview,gemma-4-26b-a4b-it

# SearXNG search router instances (comma-separated, primary first)
SEARXNG_URLS=https://search-swzb.onrender.com,https://search-dhne.onrender.com
# Optional Bearer key if ROUTER_API_KEY is enabled on SearXNG servers
# SEARXNG_API_KEY=

# Google OAuth credentials
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3002/api/auth/google/callback
APP_ORIGIN=http://127.0.0.1:3002

# MongoDB
MONGODB_URI=
DB_NAME=fastlearn

# Google Cloud authorized redirect URIs for production
# https://fastlearn.pages.dev/api/auth/google/callback
# https://fastlearn.samchukyaroslav.workers.dev/api/auth/google/callback
